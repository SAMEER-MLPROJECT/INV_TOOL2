# Copy to .env (never commit .env). Values are read at start-up.

# Evidence store: memory (default) or neo4j
AGL_GRAPH_BACKEND=memory
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# copy NEO4J_DATABASE from the Aura credentials file: newer instances use the instance id, not neo4j
NEO4J_DATABASE=neo4j

# Authentication. AGL_DEMO_PASSWORD (10+ characters) creates the evaluator accounts and keeps them on this password:
#   "Demo NBFC (synthetic data)": analyst, itadmin, viewer     "Second client (empty)": client-b
AGL_DEMO_PASSWORD=
# 1 shows the evaluator accounts and password on the sign-in page
AGL_SHOW_DEMO_LOGINS=0
# anyone can create an isolated organisation
AGL_ALLOW_SIGNUP=1
AGL_MAX_ORGS=50
# default data/agl_auth.sqlite3
AGL_AUTH_DB=
# auto = Secure cookie when served over https
AGL_COOKIE_SECURE=auto
# set to * behind a trusted proxy (Render, Railway)
AGL_FORWARDED_ALLOW_IPS=127.0.0.1
AGL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Edge devices pre-provisioned at start-up (survive hosts that wipe the disk on restart)
# AGL_EDGE_DEVICES=[{"id":"dev_unoq01","name":"UNOQ-RACK-01","location":"Server room A","secret":"<64 hex chars>"}]
AGL_EDGE_DEVICES=

AGL_MAX_UPLOAD_MB=20
AGL_MAX_RECORDS_PER_FILE=200000
# 1 exposes /api/docs (always on in single-workspace local mode)
AGL_ENABLE_DOCS=0
AGL_SECURITY_CONTACT=mailto:you@example.com

# Largest packet capture accepted by upload (MB). Other files keep AGL_MAX_UPLOAD_MB.
AGL_MAX_CAPTURE_MB=100
